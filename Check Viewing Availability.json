    {
      "parameters": {
        "jsCode": "const date = $('Webhook').first().json.body.date || \"\";\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) {\n  return [{ json: { error: \"Invalid date. Use YYYY-MM-DD.\" } }];\n}\n\nconst slots = [\"10:00 AM\", \"12:00 PM\", \"2:00 PM\", \"4:00 PM\"];\nconst to24 = (t) => {\n  const [time, ap] = t.split(\" \");\n  let h = Number(time.split(\":\")[0]);\n  if (ap === \"PM\" && h !== 12) h += 12;\n  if (ap === \"AM\" && h === 12) h = 0;\n  return h;\n};\nconst pad = (n) => String(n).padStart(2, \"0\");\n\nconst busy = $input.all()\n  .map(i => i.json)\n  .filter(e => e && e.start)\n  .map(e => ({\n    s: new Date(e.start.dateTime || e.start.date).getTime(),\n    e: new Date(e.end.dateTime || e.end.date).getTime()\n  }));\n\nconst free = slots.filter(t => {\n  const h = to24(t);\n  const s = new Date(`${date}T${pad(h)}:00:00+01:00`).getTime();\n  const e = new Date(`${date}T${pad(h + 1)}:00:00+01:00`).getTime();\n  return !busy.some(b => s < b.e && e > b.s);\n});\n\nreturn [{ json: { date, free_slots: free, booked_slots: slots.filter(t => !free.includes(t)) } }];"
      },
